services:
  backend:
    build:
      context: ./server
    container_name: assetflow_backend

    env_file:
      - ./server/.env

    environment:
      NODE_ENV: production
      PORT: 5000

    ports:
      - "5000:5000"

    volumes:
      # Persist uploaded files
      - uploads:/app/uploads

    networks:
      - assetflow-network

    restart: unless-stopped

  frontend:
    build:
      context: ./client
      args:
        VITE_API_BASE_URL: http://localhost:5000/api

    container_name: assetflow_frontend

    ports:
      - "5173:5173"

    depends_on:
      - backend

    networks:
      - assetflow-network

    restart: unless-stopped

networks:
  assetflow-network:
    driver: bridge

volumes:
  uploads: